{
  "ignoreCommand": "bash scripts/vercel-ignore.sh",
  "crons": [
    {
      "path": "/api/cron/webinar-reminder",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/offline-event-reminder",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/campaign-send",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/followup-reminder",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/stale-conversations",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/telegram-brief?kind=morning",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/telegram-brief?kind=pulse",
      "schedule": "30 7 * * *"
    },
    {
      "path": "/api/cron/telegram-brief?kind=evening",
      "schedule": "30 14 * * *"
